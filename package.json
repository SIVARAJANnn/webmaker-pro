{
  "name": "webmaker-package",
  "version": "0.3.2",
  "private": true,
  "description": "Personal, extensible Webmaker skills and 3D website library toolkit",
  "type": "module",
  "engines": {
    "node": ">=22.20"
  },
  "files": [
    "skills/",
    "docs/",
    "CONTRIBUTING.md",
    "scripts/",
    "studio/",
    "templates/registry.json",
    "templates/product-showcase/README.md",
    "templates/product-showcase/package.json",
    "templates/product-showcase/index.html",
    "templates/product-showcase/src/",
    "templates/product-showcase/assets/",
    "templates/product-showcase/scripts/",
    "checks/",
    "catalog.json",
    "sources.lock.json",
    "plugin.json",
    "THIRD_PARTY_NOTICES.md",
    "README.md",
    "tsconfig.json",
    "npm-shrinkwrap.json",
    "integrations/model-viewer/package.json",
    "integrations/model-viewer/npm-shrinkwrap.json",
    "templates/product-showcase/npm-shrinkwrap.json"
  ],
  "scripts": {
    "studio": "node studio/server.mjs",
    "skills:install": "node scripts/install-skills.mjs",
    "check": "node scripts/check-package.mjs",
    "check:docs": "node scripts/check-docs.mjs",
    "check:types": "tsc --noEmit",
    "sources:restore": "node scripts/restore-sources.mjs",
    "sources:status": "node scripts/restore-sources.mjs --status",
    "check:browser": "node scripts/check-browser.mjs",
    "check:studio": "node scripts/check-studio.mjs",
    "model:prepare": "node scripts/prepare-model.mjs"
  },
  "dependencies": {
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@react-three/postprocessing": "3.2.2",
    "@shadergradient/react": "2.4.20",
    "camera-controls": "3.1.2",
    "gsap": "3.15.1",
    "lenis": "1.3.27",
    "liquid-glass-react": "1.1.1",
    "ogl": "1.0.11",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.187.0",
    "three-stdlib": "2.36.1"
  },
  "devDependencies": {
    "@gltf-transform/cli": "4.5.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.187.0",
    "axe-core": "4.14.0",
    "gltfjsx": "6.5.3",
    "playwright": "1.65.0",
    "typescript": "7.0.2"
  },
  "overrides": {
    "@donmccurdy/caporal": {
      "glob": "14.0.4"
    },
    "gltfjsx": {
      "@gltf-transform/core": "4.5.1",
      "@gltf-transform/extensions": "4.5.1",
      "@gltf-transform/functions": "4.5.1",
      "sharp": "0.35.5"
    }
  }
}
